# ─── Trading Journal — Local Dev Environment ─────────────────────────
# Copy to .env (gitignored) and customize as required.
# Leave OAuth values blank to disable that provider on the login page.

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_DB=tj
POSTGRES_USER=tj
POSTGRES_PASSWORD=devpass
DATABASE_URL=postgres://tj:devpass@localhost:5432/tj?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ──────────────────────────────────────────────────────────────
API_PORT=8080
LOG_LEVEL=info                    # debug | info | warn | error
ENV=development                   # development | staging | production
JWT_ED25519_PRIVATE_KEY_PATH=./keys/ed25519.pem

# ── Web ──────────────────────────────────────────────────────────────
WEB_PORT=3000
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

# ── OAuth: Google ────────────────────────────────────────────────────
# Leave blank to disable Google login on the UI.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/oauth/google/callback

# ── OAuth: Line ──────────────────────────────────────────────────────
# Leave blank to disable Line login on the UI.
OAUTH_LINE_CLIENT_ID=
OAUTH_LINE_CLIENT_SECRET=
OAUTH_LINE_REDIRECT_URI=http://localhost:8080/v1/auth/oauth/line/callback

# ── Cloudinary (Phase 1 — trade screenshots) ─────────────────────────
# Leave blank to disable image uploads (Phase 1 trade detail).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=trading-journal

# ── Phase 2 — Broker sync ────────────────────────────────────────────
# SyncWorker poll cadence (seconds). Default 30.
SYNC_POLL_INTERVAL_SECONDS=30

# Phase 4 — real MetaApi (Phase 2 ships with mock provider only)
# METAAPI_TOKEN=
# METAAPI_REGION=ap-southeast
# METAAPI_ACCOUNT_ID=

# ── Phase 4 — Billing (Stripe) ──────────────────────────────────────
# Leave blank to use StubBillingService (dev / tests).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_UPLOAD_JOURNAL=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=

# ── Phase 4 — Email (SMTP) ───────────────────────────────────────────
# Leave blank to use StubMailer (writes .eml files to a temp dir).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Trading Journal <noreply@trading-journal.local>

# ── Phase 5 — Public API + API Keys ──────────────────────────────────
# Per-key rate limit on the /v1/public/* surface. Default: 60 req/min,
# burst 10.
API_PUBLIC_RATE_PER_MINUTE=60
API_PUBLIC_RATE_BURST=10

# ── Phase 5.1 — Rate limit backend ───────────────────────────────────
# `memory`  — in-process sync.Map (default; correct for dev / single replica)
# `redis`   — atomic Lua token bucket (correct across replicas; needs Redis)
RATE_LIMIT_BACKEND=memory

# Redis bucket key namespace (Phase 5.1 Redis backend only).
RATE_LIMIT_KEY_PREFIX=trj:rl:

# Idle GC for bucket keys — 1h default.
RATE_LIMIT_TTL_SECONDS=3600

# ── Phase 5.1 — Integration tests ────────────────────────────────────
# Set to `on` to run full-stack testcontainers-go flows (needs Docker).
# Local dev default: off. CI default: on.
INTEGRATION_TESTS=off

# ── Phase 5.2 — Webhook delivery ─────────────────────────────────────
# Poll cadence for the WebhookWorker (seconds).
WEBHOOK_POLL_INTERVAL_SECONDS=30

# Max deliveries picked per worker tick.
WEBHOOK_BATCH_SIZE=50

# Per-delivery HTTP timeout (seconds).
WEBHOOK_HTTP_TIMEOUT_SECONDS=10

# Max attempts before marking a delivery as exhausted.
WEBHOOK_MAX_ATTEMPTS=5

# ── Phase 6 — AI analysis (per-trade commentary) ─────────────────────
# `stub`     — hardcoded canned response (no external calls; CI default)
# `openai`   — OpenAI Chat Completions API (needs OPENAI_API_KEY)
# `anthropic` — Anthropic Messages API (needs ANTHROPIC_API_KEY)
AI_PROVIDER=stub

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Output token cap per analysis request.
AI_MAX_TOKENS=600

# ── Phase 7 — Stripe webhook state machine ──────────────────────────
# Tolerance window for the Stripe-Signature header (seconds).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ── Phase 8 — Real MetaApi REST ──────────────────────────────────────
# METAAPI_TOKEN=
# METAAPI_REGION=ap-southeast
# METAAPI_ACCOUNT_ID=

# Timeout for polling until an account reaches DEPLOYED state (seconds).
METAAPI_DEPLOY_TIMEOUT_SECONDS=10

# Per-request HTTP timeout to MetaApi (seconds).
METAAPI_HTTP_TIMEOUT_SECONDS=15

# ── Phase 9 — Embedding (RAG over trade history) ────────────────────
# `stub`   — deterministic hash-based vectors (no external calls; CI default)
# `openai` — OpenAI Embeddings API (needs OPENAI_API_KEY; uses OPENAI_EMBED_MODEL)
EMBED_PROVIDER=stub

# OpenAI embedding model (text-embedding-3-small = 1536 dims, ~$0.02/1M tokens).
OPENAI_EMBED_MODEL=text-embedding-3-small

# Max texts per OpenAI embeddings batch (irrelevant for stub).
EMBED_BATCH_SIZE=20

# Note: Postgres needs the pgvector extension. CI uses `pgvector/pgvector:pg16`.
# In managed Postgres, ops should `CREATE EXTENSION IF NOT EXISTS vector;` before
# applying migration 0010_phase9 (which is idempotent — `CREATE EXTENSION IF NOT
# EXISTS vector;` is the first statement).
